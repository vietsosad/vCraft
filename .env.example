# Sao chép thành .env rồi chỉnh giá trị. KHÔNG commit file .env.

# PostgreSQL (docker compose up -d db mở ở cổng 5434)
DATABASE_URL="postgresql://vcraft:vcraft@localhost:5434/vcraft?schema=public"

# Địa chỉ công khai – dùng để sinh nội dung mã QR ({APP_URL}/q/{mã-lô}).
# Khi demo quét bằng điện thoại, đặt thành IP LAN (http://192.168.x.x:3000) hoặc URL tunnel.
APP_URL="http://localhost:3000"

# Khóa AES-256-GCM (32 byte, base64) để mã hóa số CCCD. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY="thay-bang-32-byte-base64"

# Bật thanh "Demo vấn đáp" chuyển vai trò 1 cú bấm. Đặt "false" khi triển khai thật.
DEMO_MODE="true"

# Trợ lý AI dùng Claude khi có khóa; để trống thì tự chạy chế độ tra cứu cục bộ trên CSDL.
ANTHROPIC_API_KEY=""

# (Tùy chọn) nguồn tile bản đồ cho proxy /tiles, cách nhau bằng dấu phẩy
# MAP_TILE_UPSTREAMS="https://tile.openstreetmap.org,https://tile.openstreetmap.de"
